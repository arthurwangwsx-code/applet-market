{
  "schemaVersion": 1,
  "appId": "com.aibox.music",
  "version": "1.3.0",
  "releasedAt": "2026-08-05T01:28:14Z",
  "notes": "迁到 TS 构建管线 + @aibox/applet-sdk，运行形态改为构建型（端上不再转译）。封面改走 applet:// 图片代理（原来是把整张图 base64 塞进 JS 内存，比原图还大三分之一，列表一长必然吃满内存）。",
  "localizedNotes": {
    "en": "Migrated to the TS build pipeline and @aibox/applet-sdk. Artwork now streams through the applet:// image proxy instead of being inlined as base64 data URLs."
  },
  "minHostVersion": "1.0.0",
  "manifest": {
    "name": "音乐",
    "localizedNames": {
      "en": "Music"
    },
    "icon": "music.note",
    "iconTintHex": "FF6B6B",
    "summary": "本地与 Apple Music 播放器",
    "localizedSummaries": {
      "en": "Local and Apple Music player"
    },
    "template": "react",
    "entry": "index.html",
    "securityMode": "secure",
    "permissions": {
      "network": true,
      "storage": true,
      "ai": false,
      "networkAllowed": [
        "mzstatic.com"
      ],
      "capabilities": [
        "music",
        "haptics",
        "share",
        "open",
        "ui"
      ]
    },
    "presentation": {
      "default": "page",
      "surfaces": [
        "page",
        "fullscreen"
      ],
      "subpages": true
    },
    "actions": [
      {
        "id": "music_now_playing_summary",
        "name": "nowPlayingSummary",
        "displayName": "当前播放摘要",
        "summary": "Return the current track, queue summary, sleep timer and lyrics availability in one call, instead of chaining music_status + music_queue + music_lyrics.",
        "keywords": [
          "music",
          "now playing",
          "queue",
          "音乐",
          "正在播放",
          "队列"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"isPlaying\":{\"type\":\"boolean\"},\"playbackState\":{\"type\":\"string\"},\"track\":{\"type\":[\"object\",\"null\"]},\"positionSeconds\":{\"type\":\"integer\"},\"durationSeconds\":{\"type\":\"integer\"},\"queueCount\":{\"type\":\"integer\"},\"currentIndex\":{\"type\":\"integer\"},\"upNext\":{\"type\":\"array\"},\"repeatMode\":{\"type\":\"string\"},\"isShuffled\":{\"type\":\"boolean\"},\"sleepTimer\":{\"type\":[\"string\",\"null\"]},\"lyrics\":{\"type\":\"object\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation",
          "applet"
        ],
        "effect": "read",
        "readOnly": true,
        "idempotent": true
      },
      {
        "id": "music_play_most_played",
        "name": "playMostPlayed",
        "displayName": "播放最常听的歌",
        "summary": "Play the user's most-played tracks, ranked by this app's own play history (the host music tools do not expose play history).",
        "keywords": [
          "music",
          "most played",
          "history",
          "音乐",
          "最常播放",
          "播放历史"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":50,\"description\":\"How many tracks to queue (default 20).\"}},\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"queued\":{\"type\":\"integer\"},\"startedWith\":{\"type\":[\"string\",\"null\"]},\"message\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation",
          "shortcut"
        ],
        "effect": "mediaPlayback",
        "readOnly": false,
        "idempotent": false
      },
      {
        "id": "music_resume_last",
        "name": "resumeLast",
        "displayName": "接着上次继续听",
        "summary": "Resume the last track this app played, seeking back to the stored position (this app's own restore point; no host tool persists it).",
        "keywords": [
          "music",
          "resume",
          "continue",
          "音乐",
          "继续播放",
          "接着听"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"track\":{\"type\":[\"object\",\"null\"]},\"positionSeconds\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation",
          "shortcut"
        ],
        "effect": "mediaPlayback",
        "readOnly": false,
        "idempotent": false
      },
      {
        "id": "music_toggle_shuffle",
        "name": "toggleShuffle",
        "displayName": "随机播放",
        "summary": "Toggle shuffle on the host playback engine. Drives the ⋯ menu row, so it is a UI action rather than an agent tool (music_shuffle already covers agents).",
        "headless": false,
        "visibility": [
          "userInterface"
        ],
        "effect": "mediaPlayback",
        "readOnly": false
      },
      {
        "id": "music_set_repeat",
        "name": "setRepeat",
        "displayName": "循环模式",
        "summary": "Set the repeat mode to off / one / all. Input is the bare mode string supplied by the ⋯ menu row.",
        "headless": false,
        "visibility": [
          "userInterface"
        ],
        "effect": "mediaPlayback",
        "readOnly": false
      },
      {
        "id": "music_set_sleep_timer",
        "name": "setSleepTimer",
        "displayName": "睡眠定时器",
        "summary": "Set or cancel the sleep timer. Input is {minutes} for a preset, {mode:'endOfTrack'} to stop after the current song, or {mode:'off'} to cancel.",
        "headless": false,
        "visibility": [
          "userInterface"
        ],
        "effect": "mediaPlayback",
        "readOnly": false
      },
      {
        "id": "music_open_effects",
        "name": "openEffects",
        "displayName": "音效",
        "summary": "Open the audio effects subpage.",
        "headless": false,
        "visibility": [
          "userInterface"
        ],
        "effect": "nativePresentation",
        "readOnly": true
      },
      {
        "id": "music_share_current",
        "name": "shareCurrent",
        "displayName": "分享当前歌曲",
        "summary": "Share the current track through the system share sheet.",
        "headless": false,
        "visibility": [
          "userInterface"
        ],
        "effect": "nativePresentation",
        "readOnly": true
      },
      {
        "id": "music_open_settings",
        "name": "openSettings",
        "displayName": "音乐设置",
        "summary": "Open the music settings subpage.",
        "headless": false,
        "visibility": [
          "userInterface"
        ],
        "effect": "nativePresentation",
        "readOnly": true
      }
    ],
