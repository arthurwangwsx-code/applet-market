            },
            "icon": "magnifyingglass"
          },
          {
            "id": "mine",
            "title": "我的",
            "localizedTitles": {
              "en": "Mine"
            },
            "icon": "person",
            "selectedIcon": "person.fill"
          }
        ]
      }
    },
    "runtimeKind": "bundle"
  },
