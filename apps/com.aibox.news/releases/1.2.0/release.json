  "manifest": {
    "name": "资讯",
    "localizedNames": {
      "en": "News"
    },
    "icon": "newspaper.fill",
    "iconTintHex": "E8552D",
    "summary": "RSS 聚合阅读器",
    "localizedSummaries": {
      "en": "RSS reader"
    },
