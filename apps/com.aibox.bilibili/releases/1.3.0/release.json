{
  "schemaVersion": 1,
  "appId": "com.aibox.bilibili",
  "version": "1.3.0",
  "releasedAt": "2026-08-05T01:27:37Z",
  "notes": "迁到 TS 构建管线 + @aibox/applet-sdk：桥胶水统一（confirm 不可用一律回 false、openURL 超时封顶、图片走 applet:// 代理），运行形态改为构建型（端上不再转译）。",
  "localizedNotes": {
    "en": "Migrated to the TS build pipeline and @aibox/applet-sdk; bridge glue unified and the runtime is now prebuilt (no on-device transpile)."
  },
  "manifest": {
    "name": "哔哩哔哩",
    "localizedNames": {
      "en": "Bilibili"
    },
    "icon": "play.tv.fill",
    "iconTintHex": "FB7299",
    "summary": "看视频、搜索、追更",
    "localizedSummaries": {
      "en": "Browse, search and watch Bilibili"
    },
    "template": "react",
    "entry": "index.html",
    "securityMode": "secure",
    "permissions": {
      "network": true,
      "storage": true,
      "ai": false,
      "networkAllowed": [
        "api.bilibili.com",
        "passport.bilibili.com",
        "www.bilibili.com",
        "hdslb.com"
      ],
      "capabilities": [
        "video",
        "secrets",
        "browser",
        "share",
        "clipboard",
        "haptics",
        "toast"
      ]
    },
    "presentation": {
      "default": "page",
      "surfaces": [
        "page",
        "fullscreen"
      ],
      "subpages": true
    },
    "actions": [
      {
        "id": "bili_search",
        "name": "search",
        "displayName": "搜索哔哩哔哩",
        "summary": "Search Bilibili for videos by keyword. Returns each match with its BV id, title, uploader, duration and play count. Pass a BV id to the play action to watch one.",
        "keywords": [
          "bilibili",
          "b站",
          "哔哩哔哩",
          "搜视频",
          "找视频",
          "search bilibili"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"required\":[\"keyword\"],\"properties\":{\"keyword\":{\"type\":\"string\",\"description\":\"What to search for.\"},\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":20,\"description\":\"How many results to return (default 10).\"}},\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"videos\":{\"type\":\"array\"},\"text\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "externalNetwork",
        "readOnly": true
      },
      {
        "id": "bili_trending",
        "name": "trending",
        "displayName": "哔哩哔哩热门",
        "summary": "What is popular on Bilibili right now. kind 'popular' is the trending feed, 'ranking' is the all-site leaderboard.",
        "keywords": [
          "bilibili热门",
          "b站排行",
          "哔哩哔哩排行榜",
          "bilibili trending"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"kind\":{\"type\":\"string\",\"enum\":[\"popular\",\"ranking\"]},\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":30}},\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"videos\":{\"type\":\"array\"},\"text\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "externalNetwork",
        "readOnly": true
      },
      {
        "id": "bili_play",
        "name": "play",
        "displayName": "播放哔哩哔哩视频",
        "summary": "Play a Bilibili video by its BV id on the native full-screen player, with lock-screen controls and picture-in-picture. Get a BV id from the search or trending action first.",
        "keywords": [
          "播放b站",
          "看视频",
          "播放哔哩哔哩",
          "play bilibili"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"required\":[\"bvid\"],\"properties\":{\"bvid\":{\"type\":\"string\",\"description\":\"The BV id, e.g. BV1bz3Q6oEMP.\"}},\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"video\":{\"type\":\"object\"},\"text\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "mediaPlayback"
      }
    ],
    "scene": {
      "tabBar": {
        "style": "glass",
        "items": [
          {
            "id": "feed",
            "title": "首页",
            "localizedTitles": {
              "en": "Home"
            },
            "icon": "house",
            "selectedIcon": "house.fill"
