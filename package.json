{
  "name": "aibox-applet-market",
  "private": true,
  "version": "1.0.0",
  "description": "AiBox 小应用市场：静态 JSON 分发仓库。源码是单一真值，发布产物由 scripts/ 生成。",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test scripts/tests/*.test.mjs && node packages/aibox-tsbuild/tests/runtime-sharing.test.mjs && npm test --workspace @aibox/applet-sdk",
    "verify": "node scripts/verify.mjs",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "validate": "node scripts/validate.mjs",
    "registry": "node scripts/build-registry.mjs",
    "new": "node scripts/new-app.mjs",
    "release": "node scripts/release.mjs",
    "sdk:types": "node scripts/gen-sdk-types.mjs",
    "sdk:types:check": "node scripts/gen-sdk-types.mjs --check",
    "sdk:build": "npm run build --workspace @aibox/applet-sdk",
    "audit:result-schema": "node scripts/audit-result-schema.mjs",
    "audit:host-forks": "node scripts/audit-host-forks.mjs",
    "audit:hand-rolled-touch": "node scripts/audit-hand-rolled-touch.mjs",
    "audit:typescript": "node scripts/audit-typescript-policy.mjs",
    "audit:contracts": "node scripts/audit-runtime-contracts.mjs",
    "audit:budgets": "node scripts/audit-budgets.mjs",
    "audit": "npm run audit:result-schema && npm run audit:host-forks && npm run audit:hand-rolled-touch && npm run audit:undefined-names && npm run audit:typescript && npm run audit:contracts && npm run audit:budgets",
    "audit:undefined-names": "node scripts/audit-undefined-names.mjs",
    "budgets:update": "node scripts/audit-budgets.mjs --update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3"
  }
}
