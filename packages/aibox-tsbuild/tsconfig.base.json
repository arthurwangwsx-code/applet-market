{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // 产物必须是**保结构的多文件 ESM**：宿主的源码型运行时按路径逐个伺服，不做打包。
    "module": "ESNext",
    // bundler 解析：允许在 import 里写 `./foo.js` 而实际文件是 `foo.tsx`（产物里那个 `.js` 才是对的）。
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // 迁移期：`.jsx`/`.js` 原样通过（只转 JSX、不检查），这样一个应用可以先换工具链、再逐文件加类型。
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,

    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    // `aibox/ui` 不是 npm 包 —— 它是 `applet://localhost/runtime/aibox-ui.mjs`，
    // 构建时恒 external、运行时由 import map 解析。TS 找不到它的声明会报 TS2307/TS7016，
    // 所以用 paths 指到随本预设一起发的 types/aibox-ui.d.ts。
    // 相对路径按 TS 5.0+ 的规则**相对本文件**解析，继承方一个字节都不用写。
    // ⚠️ `index.mjs` 里是手工组装 CompilerOptions（basePath 传的是应用的 src/），
    //    那条路径上必须先把这里的相对项绝对化，否则会错解到应用目录下 → 找不到声明。
    "paths": {
      "aibox/ui": ["./types/aibox-ui.d.ts"]
    }
  }
}
