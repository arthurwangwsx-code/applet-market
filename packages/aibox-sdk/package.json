{
  "name": "@aibox/applet-sdk",
  "version": "1.0.0",
  "description": "AiBox 小应用前端 SDK：aibox.* 全量类型、能力探测与降级、错误规范化、net 便利封装、类型化 action、React hooks。",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "src",
    "scripts-postbuild.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./global": {
      "types": "./dist/generated/aibox-global.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts-postbuild.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.9.3"
  }
}
