    "actions": [
      {
        "id": "memo_list",
        "name": "memo_list",
        "displayName": "列出录音",
        "summary": "Lists this app's voice recordings, newest first. Filter by a text query or favourites only. Read-only.",
        "keywords": [
          "voice memo",
          "recording",
          "audio note",
          "list recordings",
          "录音",
          "语音备忘录",
          "录音列表"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Match against the recording title.\"},\"favOnly\":{\"type\":\"boolean\",\"description\":\"Only favourited recordings.\"}},\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"required\":[\"ok\",\"text\"],\"properties\":{\"ok\":{\"type\":\"boolean\"},\"text\":{\"type\":\"string\"},\"count\":{\"type\":\"integer\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "read",
        "readOnly": true,
        "idempotent": true
      },
      {
        "id": "memo_transcribe",
        "name": "memo_transcribe",
        "displayName": "转写录音",
        "summary": "Transcribes one recording with Apple speech recognition and returns the text. It waits for completion, so a long recording can take minutes. Already-transcribed recordings return immediately; read them with memo_transcript.",
        "keywords": [
          "transcribe",
          "speech to text",
          "transcript",
          "转写",
          "转录",
          "语音转文字"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"description\":\"The recording id from memo_list.\"},\"locale\":{\"type\":\"string\",\"description\":\"BCP-47 locale such as en_US or zh_CN. Defaults to the configured transcription language. Pass the language actually spoken — a mismatch produces garbage.\"}},\"required\":[\"id\"],\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"required\":[\"ok\",\"text\"],\"properties\":{\"ok\":{\"type\":\"boolean\"},\"text\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "write",
        "readOnly": false,
        "idempotent": true
      },
      {
        "id": "memo_transcript",
        "name": "memo_transcript",
        "displayName": "读取转写",
        "summary": "Returns the transcript of one recording: status and the full text. Prefers the speaker-corrected version when one exists. Read-only.",
        "keywords": [
          "transcript",
          "read transcript",
          "what was said",
          "转写文本",
          "转录内容",
          "文稿"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"description\":\"The recording id from memo_list.\"}},\"required\":[\"id\"],\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"required\":[\"ok\",\"text\"],\"properties\":{\"ok\":{\"type\":\"boolean\"},\"text\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "read",
        "readOnly": true,
        "idempotent": true
      },
      {
        "id": "memo_summarize",
        "name": "memo_summarize",
        "displayName": "生成摘要",
        "summary": "Summarizes a recording's transcript and returns the summary text. Takes a template: general, meeting, interview, oneOnOne, lecture or podcast — each produces a different section structure (decisions and action items for meetings, strengths and concerns for interviews, and so on). Needs a completed transcript; run memo_transcribe first.",
        "keywords": [
          "summary",
          "summarize",
          "meeting notes",
          "minutes",
          "摘要",
          "会议纪要",
          "总结"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"description\":\"The recording id from memo_list.\"},\"template\":{\"type\":\"string\",\"enum\":[\"general\",\"meeting\",\"interview\",\"oneOnOne\",\"lecture\",\"podcast\"],\"description\":\"Summary shape; defaults to 'general'.\"}},\"required\":[\"id\"],\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"required\":[\"ok\",\"text\"],\"properties\":{\"ok\":{\"type\":\"boolean\"},\"text\":{\"type\":\"string\"},\"template\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "externalNetwork",
        "readOnly": false,
        "idempotent": false
      },
      {
        "id": "memo_action_items",
        "name": "memo_action_items",
        "displayName": "提取待办",
        "summary": "Extracts tasks, decisions and personal commitments from a recording's transcript, each with an owner and a due hint when the speaker actually stated one. Nothing is invented. Needs a completed transcript.",
        "keywords": [
          "action items",
          "todo",
          "tasks",
          "decisions",
          "follow up",
          "待办",
          "任务",
          "决定"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"description\":\"The recording id from memo_list.\"},\"force\":{\"type\":\"boolean\",\"description\":\"Re-extract instead of returning the cached result.\"}},\"required\":[\"id\"],\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"required\":[\"ok\",\"text\"],\"properties\":{\"ok\":{\"type\":\"boolean\"},\"text\":{\"type\":\"string\"},\"count\":{\"type\":\"integer\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "externalNetwork",
        "readOnly": false,
        "idempotent": false
      },
      {
        "id": "memo_ask",
        "name": "memo_ask",
        "displayName": "询问录音",
        "summary": "Answers a question about one recording using only its transcript — nothing else. Use it instead of pulling the whole transcript when the user asks something specific about a long recording.",
        "keywords": [
          "ask",
          "question",
          "what did they say",
          "询问录音",
          "问答",
          "录音里说了什么"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"description\":\"The recording id from memo_list.\"},\"question\":{\"type\":\"string\",\"description\":\"The question to answer from the transcript.\"}},\"required\":[\"id\",\"question\"],\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"required\":[\"ok\",\"text\"],\"properties\":{\"ok\":{\"type\":\"boolean\"},\"text\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "externalNetwork",
        "readOnly": true,
        "idempotent": true
      },
      {
        "id": "memo_export",
        "name": "memo_export",
        "displayName": "导出文稿",
        "summary": "Renders one recording as structured Markdown, plain text or SRT subtitles — title, created time, duration, summary, transcript, chapters, action items and translation, whichever exist. Returns the rendered text; it does not write a file.",
        "keywords": [
          "export",
          "markdown",
          "srt",
          "subtitles",
          "导出",
          "字幕",
          "文稿导出"
        ],
        "inputSchemaJSON": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"description\":\"The recording id from memo_list.\"},\"format\":{\"type\":\"string\",\"enum\":[\"markdown\",\"text\",\"srt\"],\"description\":\"Output format; defaults to 'markdown'.\"}},\"required\":[\"id\"],\"additionalProperties\":false}",
        "outputSchemaJSON": "{\"type\":\"object\",\"required\":[\"ok\",\"text\"],\"properties\":{\"ok\":{\"type\":\"boolean\"},\"text\":{\"type\":\"string\"},\"format\":{\"type\":\"string\"}}}",
        "headless": true,
        "visibility": [
          "agent",
          "automation"
        ],
        "effect": "read",
        "readOnly": true,
        "idempotent": true
      }
    ]
  },
