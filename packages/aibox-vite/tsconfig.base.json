{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "小应用工程的共享 tsconfig。target/lib 对齐 iOS 17 的 WKWebView（Safari 17）。",
  "_comment_paths": "`aibox/ui` 不是 npm 包（构建时 external、运行时由 import map 解析），TS 找不到它的声明 → TS7016。所以用 paths 指到随预设一起发的 types/aibox-ui.d.ts。相对路径按 TS 5.0+ 的规则相对**本文件**解析，继承方不用重复写一遍。在这条存在之前，唯一的绕法是每个 TS 应用各写一份 .d.ts —— 那正是框架资产要避免的复制病。",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "aibox/ui": ["./types/aibox-ui.d.ts"]
    }
  }
}
